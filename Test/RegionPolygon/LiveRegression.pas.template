// Generated by Run-LiveRegression.ps1. All coordinates belong to a fresh unsaved PCB.
function ScratchBoard:IPCB_Board;
var B:IPCB_Board; L:TStringList;
begin
 B:=PCBServer.GetCurrentPCBBoard;
 Result:=Nil;
 if B<>Nil then
  if ExtractFileName(B.FileName)='@@BOARD@@' then begin Result:=B;Exit;end;
 L:=TStringList.Create;
 try L.Add('The generated scratch PCB is not active. No fixture action was performed.');
  L.SaveToFile('@@OUTPUT@@\failure.txt');finally L.Free;end;
end;

procedure Marker(Name,Value:String);
var L:TStringList;
begin L:=TStringList.Create;try L.Add(Value);L.SaveToFile('@@OUTPUT@@\'+Name);finally L.Free;end;end;

function RectangleContour(X,Y,W,H:Double):IPCB_Contour;
var C:IPCB_Contour;
begin
 C:=PCBServer.PCBContourFactory;
 C.AddPoint(MMsToCoord(X),MMsToCoord(Y));C.AddPoint(MMsToCoord(X+W),MMsToCoord(Y));
 C.AddPoint(MMsToCoord(X+W),MMsToCoord(Y+H));C.AddPoint(MMsToCoord(X),MMsToCoord(Y+H));
 C.AddPoint(MMsToCoord(X),MMsToCoord(Y));Result:=C;
end;

procedure RegisterObject(B:IPCB_Board;P:IPCB_Primitive);
begin
 B.AddPCBObject(P);
 B.DispatchMessage(B.I_ObjectAddress,c_Broadcast,PCBM_BoardRegisteration,P.I_ObjectAddress);
end;

function Region(B:IPCB_Board;N:IPCB_Net;Layer:TLayer;X,Y,W,H:Double;Name:String;Selected,HasHole:Boolean):IPCB_Region;
var R:IPCB_Region;G:IPCB_GeometricPolygon;
begin
 R:=PCBServer.PCBObjectFactory(eRegionObject,eNoDimension,eCreate_Default);
 R.Kind:=eRegionKind_Copper;R.Layer:=Layer;R.Net:=N;R.Name:=Name;
 if HasHole then begin
  G:=PCBServer.PCBGeometricPolygonFactory;
  G.AddContourIsHole(RectangleContour(X,Y,W,H),False);
  G.AddContourIsHole(RectangleContour(X+5,Y+5,10,10),True);
  R.SetGeometricPolygon(G);
 end else R.SetOutlineContour(RectangleContour(X,Y,W,H));
 RegisterObject(B,R);R.Selected:=Selected;Result:=R;
end;

function Segment(Kind:TPolySegmentType;X,Y,CX,CY,Radius,A1,A2:Double):TPolySegment;
var S:TPolySegment;
begin
 S:=TPolySegment;S.Kind:=Kind;S.vx:=MMsToCoord(X);S.vy:=MMsToCoord(Y);
 S.cx:=MMsToCoord(CX);S.cy:=MMsToCoord(CY);S.Radius:=MMsToCoord(Radius);
 S.Angle1:=A1;S.Angle2:=A2;Result:=S;
end;

function SegmentText(S:TPolySegment):String;
begin
 Result:=IntToStr(S.Kind)+'|'+IntToStr(S.vx)+'|'+IntToStr(S.vy)+'|'+IntToStr(S.cx)+'|'+
  IntToStr(S.cy)+'|'+IntToStr(S.Radius)+'|'+FloatToStr(S.Angle1)+'|'+FloatToStr(S.Angle2);
end;

procedure Snapshot(B:IPCB_Board;Name:String);
var It:IPCB_BoardIterator;P:IPCB_Primitive;R:IPCB_Region;Poly:IPCB_Polygon;T:IPCB_Track;
 L:TStringList;I:Integer;Key,N,Base,ObjectName:String;Rect:TCoordRect;S:TPolySegment;
begin
 L:=TStringList.Create;
 try
  It:=B.BoardIterator_Create;It.SetState_FilterAll;
  try
   P:=It.FirstPCBObject;
   while P<>Nil do begin
    Key:=IntToStr(P.I_ObjectAddress);N:='';
    if P.ObjectId=eNetObject then L.Add('net|'+Key+'|'+P.Name)
    else if (P.ObjectId=eRegionObject) or (P.ObjectId=ePolyObject) or (P.ObjectId=eTrackObject) then begin
     if P.Net<>Nil then N:=P.Net.Name;
     ObjectName:='';
     if P.ObjectId=eRegionObject then begin R:=P;ObjectName:=R.Name;end;
     if P.ObjectId=ePolyObject then begin Poly:=P;ObjectName:=Poly.Name;end;
     Base:=Key+'|'+ObjectName+'|'+Layer2String(P.Layer)+'|'+N+'|'+BoolToStr(P.Selected);
     if P.ObjectId=eRegionObject then begin
      R:=P;
      // Default board-stack regions (Kind=3) do not describe free copper.
      if R.Kind<>3 then begin
       Rect:=R.BoundingRectangle;
       L.Add('region|'+Base+'|'+IntToStr(R.Kind)+'|'+IntToStr(R.HoleCount)+'|'+BoolToStr(R.InPolygon)+'|'+
        IntToStr(Rect.Left)+'|'+IntToStr(Rect.Bottom)+'|'+IntToStr(Rect.Right)+'|'+IntToStr(Rect.Top));
       if not R.InPolygon then
        for I:=0 to R.ShapeSegmentCount-1 do begin S:=R.ShapeSegments[I];L.Add('rsegment|'+Key+'|'+IntToStr(I)+'|'+SegmentText(S));end;
      end;
     end;
     if P.ObjectId=ePolyObject then begin
      Poly:=P;L.Add('polygon|'+Base+'|'+IntToStr(Poly.PointCount)+'|'+IntToStr(Poly.PolyHatchStyle));
      for I:=0 to Poly.PointCount-1 do begin S:=Poly.Segments[I];L.Add('psegment|'+Key+'|'+IntToStr(I)+'|'+SegmentText(S));end;
     end;
     if P.ObjectId=eTrackObject then begin
      T:=P;L.Add('track|'+Base+'|'+IntToStr(T.X1)+'|'+IntToStr(T.Y1)+'|'+IntToStr(T.X2)+'|'+IntToStr(T.Y2)+'|'+IntToStr(T.Width));
     end;
    end;
    P:=It.NextPCBObject;
   end;
  finally B.BoardIterator_Destroy(It);end;
  L.Sort;L.SaveToFile('@@OUTPUT@@\'+Name);
 finally L.Free;end;
end;

procedure CreateFixture;
var Doc:IServerDocument;B:IPCB_Board;N,N2:IPCB_Net;R:IPCB_Region;T:IPCB_Track;P:IPCB_Polygon;
begin
 Doc:=Client.OpenNewDocument('PCB','','@@BOARD@@',False);Client.ShowDocument(Doc);
 B:=ScratchBoard;if B=Nil then Exit;
 PCBServer.PreProcess;
 try
  N:=PCBServer.PCBObjectFactory(eNetObject,eNoDimension,eCreate_Default);N.Name:='REGRESSION_GND';RegisterObject(B,N);
  N2:=PCBServer.PCBObjectFactory(eNetObject,eNoDimension,eCreate_Default);N2.Name:='REGRESSION_VCC';RegisterObject(B,N2);
  R:=Region(B,N,eTopLayer,20,20,20,20,'HOLED_SOURCE',True,True);
  if R.HoleCount<>1 then begin Marker('failure.txt','Fixture did not retain exactly one hole.');Exit;end;
  R:=Region(B,N2,eTopLayer,28,28,4,4,'DISC_SOURCE',True,False);
  PCBServer.SendMessageToRobots(R.I_ObjectAddress,c_Broadcast,PCBM_BeginModify,c_NoEventData);
  R.ShapeSegmentCount:=2;
  R.ShapeSegments[0]:=Segment(ePolySegmentArc,32,30,30,30,2,0,180);
  R.ShapeSegments[1]:=Segment(ePolySegmentArc,28,30,30,30,2,180,360);
  R.UpdateContourFromShape(True);
  PCBServer.SendMessageToRobots(R.I_ObjectAddress,c_Broadcast,PCBM_EndModify,c_NoEventData);
  R:=Region(B,N2,eBottomLayer,60,20,20,10,'BOTTOM_SOURCE',True,False);
  PCBServer.SendMessageToRobots(R.I_ObjectAddress,c_Broadcast,PCBM_BeginModify,c_NoEventData);
  R.ShapeSegmentCount:=4;
  R.ShapeSegments[0]:=Segment(ePolySegmentLine,60,20,0,0,0,0,0);
  R.ShapeSegments[1]:=Segment(ePolySegmentLine,80,20,0,0,0,0,0);
  R.ShapeSegments[2]:=Segment(ePolySegmentLine,80,30,0,0,0,0,0);
  R.ShapeSegments[3]:=Segment(ePolySegmentLine,60,30,0,0,0,0,0);
  R.UpdateContourFromShape(True);
  PCBServer.SendMessageToRobots(R.I_ObjectAddress,c_Broadcast,PCBM_EndModify,c_NoEventData);
  R:=Region(B,N,eTopLayer,20,60,20,10,'ARC_SOURCE',True,False);
  PCBServer.SendMessageToRobots(R.I_ObjectAddress,c_Broadcast,PCBM_BeginModify,c_NoEventData);
  R.ShapeSegmentCount:=4;
  R.ShapeSegments[0]:=Segment(ePolySegmentLine,20,60,0,0,0,0,0);
  R.ShapeSegments[1]:=Segment(ePolySegmentLine,40,60,0,0,0,0,0);
  R.ShapeSegments[2]:=Segment(ePolySegmentArc,40,70,30,70,10,0,180);
  R.ShapeSegments[3]:=Segment(ePolySegmentLine,20,70,0,0,0,0,0);
  R.UpdateContourFromShape(True);
  PCBServer.SendMessageToRobots(R.I_ObjectAddress,c_Broadcast,PCBM_EndModify,c_NoEventData);
  R:=Region(B,N,eTopLayer,90,20,5,5,'KEEP_REGION',False,False);
  T:=PCBServer.PCBObjectFactory(eTrackObject,eNoDimension,eCreate_Default);
  T.Layer:=eTopLayer;T.Net:=N2;T.X1:=MMsToCoord(90);T.Y1:=MMsToCoord(40);T.X2:=MMsToCoord(95);T.Y2:=MMsToCoord(40);T.Width:=MMsToCoord(0.2);
  RegisterObject(B,T);T.Selected:=True;
  P:=PCBServer.PCBObjectFactory(ePolyObject,eNoDimension,eCreate_Default);
  P.Name:='KEEP_POLYGON';P.Layer:=eTopLayer;P.Net:=N;P.PolyHatchStyle:=ePolySolid;
  P.RemoveDead:=False;P.RemoveIslandsByArea:=False;P.PointCount:=4;
  P.Segments[0]:=Segment(ePolySegmentLine,90,60,0,0,0,0,0);
  P.Segments[1]:=Segment(ePolySegmentLine,100,60,0,0,0,0,0);
  P.Segments[2]:=Segment(ePolySegmentLine,100,70,0,0,0,0,0);
  P.Segments[3]:=Segment(ePolySegmentLine,90,70,0,0,0,0,0);
  RegisterObject(B,P);P.Rebuild;P.Selected:=True;
 finally PCBServer.PostProcess;end;
 B.ViewManager_FullUpdate;Snapshot(B,'rejection.before.txt');Marker('fixture.ready','ready');
end;

procedure RejectBatch;
var B:IPCB_Board;
begin
 B:=ScratchBoard;if B=Nil then Exit;
 ResetParameters;RunProcess('EasyEDA-Loader:EasyEDAConvertSelectedRegionToPolygon');
 B:=ScratchBoard;if B=Nil then Exit;
 Snapshot(B,'rejection.after.txt');Marker('rejection.returned','returned');
end;

procedure ConvertValid;
var B:IPCB_Board;It:IPCB_BoardIterator;P:IPCB_Primitive;
begin
 B:=ScratchBoard;if B=Nil then Exit;
 It:=B.BoardIterator_Create;It.SetState_FilterAll;
 try
  P:=It.FirstPCBObject;
  while P<>Nil do begin
   if P.ObjectId=eRegionObject then
    if P.Name='HOLED_SOURCE' then P.Selected:=False;
   P:=It.NextPCBObject;
  end;
 finally B.BoardIterator_Destroy(It);end;
 Snapshot(B,'positive.before.txt');
 ResetParameters;RunProcess('EasyEDA-Loader:EasyEDAConvertSelectedRegionToPolygon');
 B:=ScratchBoard;if B=Nil then Exit;
 Snapshot(B,'positive.after.txt');Marker('positive.returned','returned');
end;
