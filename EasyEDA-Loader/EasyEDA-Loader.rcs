PL PLEasyEDALoader:EasyEDARun Command='EasyEDA-Loader:EasyEDARun' Caption='EasyEDA &Loader...' Description='Load EasyEDA components into Altium libraries' End
PL PLEasyEDALoader:EasyEDARunPcbLib Command='EasyEDA-Loader:EasyEDARun' Caption='&Loader...' Description='Load EasyEDA components into Altium libraries' End
PL PLEasyEDALoader:EasyEDAReproject3D Command='EasyEDA-Loader:EasyEDAReproject3D' Caption='&Reproject 3D' Description='Regenerate 3D model projection and assembly labels for the active footprint' End
PL PLEasyEDALoader:EasyEDAAlign3DModel Command='EasyEDA-Loader:EasyEDAAlign3DModel' Caption='&Align 3D model' Description='Align 3D model bodies to the active footprint pads' End

Insertion MNSchematic_EasyEDALoader TargetID='MNSchematic_Tools10' InsertType='After' RefID0='MNSchematic_Tools30'
    Link MNSchematic_EasyEDALoader10 PLID='PLEasyEDALoader:EasyEDARun' End
End

Insertion MNPCB_EasyEDALoader TargetID='MNPCB_Tools10' InsertType='Before' RefID0='MNPCB_Tools150'
    Link MNPCB_EasyEDALoader10 PLID='PLEasyEDALoader:EasyEDARun' End
End

Insertion MNPCBLib_EasyEDALoader TargetID='MNPCBLib_Tools10' InsertType='After' RefID0='MNPCBLib_Tools15'
    Tree MNPCBLib_EasyEDALoaderTree Caption='&EasyEDA' Popup='1'
        Link MNPCBLib_EasyEDALoader10 PLID='PLEasyEDALoader:EasyEDARunPcbLib' End
        Separator MNPCBLib_EasyEDALoader20 End
        Link MNPCBLib_EasyEDALoader30 PLID='PLEasyEDALoader:EasyEDAReproject3D' End
        Link MNPCBLib_EasyEDALoader40 PLID='PLEasyEDALoader:EasyEDAAlign3DModel' End
    End
End

Insertion MNSchLib_EasyEDALoader TargetID='MNSchematic_SchLibMenuTools10' InsertType='After' RefID0='MNSchematic_SchLibMenuTools20'
    Link MNSchLib_EasyEDALoader10 PLID='PLEasyEDALoader:EasyEDARun' End
End

Insertion MNText_EasyEDALoader TargetID='MNTextEditMenu' InsertType='After' RefID0='MNTextEditMenu_Tools'
    Link MNText_EasyEDALoader10 PLID='PLEasyEDALoader:EasyEDARun' End
End

Insertion MNNoDocument_EasyEDALoader TargetID='MNNoDocument' InsertType='After' RefID0='MNNoDocument_Project'
    Link MNNoDocument_EasyEDALoader10 PLID='PLEasyEDALoader:EasyEDARun' End
End
