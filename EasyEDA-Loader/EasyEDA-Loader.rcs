PL PLEasyEDALoader:EasyEDARun Command='EasyEDA-Loader:EasyEDARun' Caption='EasyEDA &Loader...' Description='Load EasyEDA components into Altium libraries' End
PL PLEasyEDALoader:EasyEDARunPcb Command='EasyEDA-Loader:EasyEDARun' Caption='&Loader' Description='Load EasyEDA components into Altium libraries' End
PL PLEasyEDALoader:EasyEDARunPcbLib Command='EasyEDA-Loader:EasyEDARun' Caption='&Loader...' Description='Load EasyEDA components into Altium libraries' End
PL PLEasyEDALoader:EasyEDAReproject3D Command='EasyEDA-Loader:EasyEDAReproject3D' Caption='&Reproject 3D' Description='Regenerate 3D model projection and assembly labels for the active footprint' End
PL PLEasyEDALoader:EasyEDAAlign3DModel Command='EasyEDA-Loader:EasyEDAAlign3DModel' Caption='&Align 3D model' Description='Align 3D model bodies to the active footprint pads' End
PL PLEasyEDALoader:EasyEDACreateCustomPadFromSelected Command='EasyEDA-Loader:EasyEDACreateCustomPadFromSelected' Caption='Create &Custom Pad from Selected' Description='Replace selected pads and copper primitives with one custom pad' End
PL PLEasyEDALoader:EasyEDASwitchTopSignalLayer Command='EasyEDA-Loader:EasyEDASwitchTopSignalLayer' Caption='&Top' Shortcut1='Ctrl+Plus' Description='Switch to the top signal layer' End
PL PLEasyEDALoader:EasyEDASwitchBottomSignalLayer Command='EasyEDA-Loader:EasyEDASwitchBottomSignalLayer' Caption='&Bottom' Shortcut1='Ctrl+Minus' Description='Switch to the bottom signal layer' End
PL PLEasyEDALoader:EasyEDASwitchNextSignalLayer Command='EasyEDA-Loader:EasyEDASwitchNextSignalLayer' Caption='&Next Signal' Shortcut1='Ctrl+Shift+Plus' Description='Switch to the next displayed signal layer' End
PL PLEasyEDALoader:EasyEDASwitchPreviousSignalLayer Command='EasyEDA-Loader:EasyEDASwitchPreviousSignalLayer' Caption='&Previous Signal' Shortcut1='Ctrl+Shift+Minus' Description='Switch to the previous displayed signal layer' End
PL PLEasyEDALoader:EasyEDASwitchToSelectedPrimitiveLayer Command='EasyEDA-Loader:EasyEDASwitchToSelectedPrimitiveLayer' Caption='Switch to Selected &Primitive Layer' Description='Switch to the selected PCB primitive layer' End
PL PLEasyEDALoader:EasyEDAExportShapeAll Command='EasyEDA-Loader:EasyEDAExportShapeAll' Caption='&All components' Description='Export Mechanical 2 component shape SVG files for all PCB components or footprints' End
PL PLEasyEDALoader:EasyEDAExportShapeSelected Command='EasyEDA-Loader:EasyEDAExportShapeSelected' Caption='&Selected component' Description='Export a Mechanical 2 component shape SVG file for the selected PCB component or active footprint' End

Insertion MNSchematic_EasyEDALoader TargetID='MNSchematic_Tools10' InsertType='After' RefID0='MNSchematic_Tools30'
    Link MNSchematic_EasyEDALoader10 PLID='PLEasyEDALoader:EasyEDARun' End
End

Insertion MNPCB_EasyEDALoader TargetID='MNPCB_Tools10' InsertType='Before' RefID0='MNPCB_Tools150'
    Tree MNPCB_EasyEDALoaderTree Caption='&EasyEDA' Popup='1'
        Link MNPCB_EasyEDALoader10 PLID='PLEasyEDALoader:EasyEDARunPcb' End
        Separator MNPCB_EasyEDALoader20 End
        Tree MNPCB_EasyEDAExportShapeTree Caption='Export &shape' Popup='1'
            Link MNPCB_EasyEDAExportShape10 PLID='PLEasyEDALoader:EasyEDAExportShapeAll' End
            Link MNPCB_EasyEDAExportShape20 PLID='PLEasyEDALoader:EasyEDAExportShapeSelected' End
        End
        Separator MNPCB_EasyEDALoader50 End
        Tree MNPCB_EasyEDALayerSwitchTree Caption='&Layer Switch' Popup='1'
            Link MNPCB_EasyEDALayerSwitch10 PLID='PLEasyEDALoader:EasyEDASwitchTopSignalLayer' End
            Link MNPCB_EasyEDALayerSwitch20 PLID='PLEasyEDALoader:EasyEDASwitchBottomSignalLayer' End
            Link MNPCB_EasyEDALayerSwitch30 PLID='PLEasyEDALoader:EasyEDASwitchNextSignalLayer' End
            Link MNPCB_EasyEDALayerSwitch40 PLID='PLEasyEDALoader:EasyEDASwitchPreviousSignalLayer' End
            Separator MNPCB_EasyEDALayerSwitch50 End
            Link MNPCB_EasyEDALayerSwitch60 PLID='PLEasyEDALoader:EasyEDASwitchToSelectedPrimitiveLayer' End
        End
    End
End

Insertion MNPCBLib_EasyEDALoader TargetID='MNPCBLib_Tools10' InsertType='After' RefID0='MNPCBLib_Tools15'
    Tree MNPCBLib_EasyEDALoaderTree Caption='&EasyEDA' Popup='1'
        Link MNPCBLib_EasyEDALoader10 PLID='PLEasyEDALoader:EasyEDARunPcbLib' End
        Separator MNPCBLib_EasyEDALoader20 End
        Link MNPCBLib_EasyEDALoader30 PLID='PLEasyEDALoader:EasyEDAReproject3D' End
        Link MNPCBLib_EasyEDALoader40 PLID='PLEasyEDALoader:EasyEDAAlign3DModel' End
        Link MNPCBLib_EasyEDALoader50 PLID='PLEasyEDALoader:EasyEDACreateCustomPadFromSelected' End
        Separator MNPCBLib_EasyEDALoader60 End
        Tree MNPCBLib_EasyEDAExportShapeTree Caption='Export &shape' Popup='1'
            Link MNPCBLib_EasyEDAExportShape10 PLID='PLEasyEDALoader:EasyEDAExportShapeAll' End
            Link MNPCBLib_EasyEDAExportShape20 PLID='PLEasyEDALoader:EasyEDAExportShapeSelected' End
        End
    End
End

Insertion MNSchLib_EasyEDALoader TargetID='MNSchematic_SchLibMenuTools10' InsertType='After' RefID0='MNSchematic_SchLibMenuTools20'
    Link MNSchLib_EasyEDALoader10 PLID='PLEasyEDALoader:EasyEDARun' End
End

Insertion MNText_EasyEDALoader TargetID='MNTextEditMenu' InsertType='After' RefID0='MNTextEditMenu_Tools'
    Link MNText_EasyEDALoader10 PLID='PLEasyEDALoader:EasyEDARun' End
End

Insertion MNNoDocument_EasyEDALoader TargetID='MNNoDocument' InsertType='After' RefID0='MNNoDocument_Project'
    Link MNNoDocument_EasyEDALoader10 PLID='PLEasyEDALoader:EasyEDARun' End
End
