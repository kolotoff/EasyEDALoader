ClientInsFile 1.0

Server
    EditorName        = 'EasyEDA-Loader'
    EditorExePath     = 'EasyEDA-Loader.DLL'
    EditorDescription = 'EasyEDA component loader for Altium Designer'
    Version           = 'Version 1.0.0.15'
    Date              = '6/1/2026'
    HelpAboutInfo     = 'EasyEDA component loader for Altium Designer.'
    Copyright         = ''
    SupportsDDB       = True
    Updates           = 'DXP'
    Updates           = 'ADVSCH'
    Updates           = 'ADVPCB'
    Updates           = 'TEXTEDIT'
    Updates           = 'WorkspaceManager'
    SystemExtension   = True
End

Command  Name = 'EasyEDARun' LongSummary = 'Open EasyEDA Loader' End
Command  Name = 'EasyEDAReproject3D' LongSummary = 'Reproject the active PCB library footprint 3D model' End
Command  Name = 'EasyEDAAlign3DModel' LongSummary = 'Align the active PCB library footprint 3D model by pads' End
Command  Name = 'EasyEDACreateCustomPadFromSelected' LongSummary = 'Create a custom pad from selected PCB library primitives' End
Command  Name = 'EasyEDASwitchTopSignalLayer' LongSummary = 'Switch the active PCB editor to the top signal layer' End
Command  Name = 'EasyEDASwitchBottomSignalLayer' LongSummary = 'Switch the active PCB editor to the bottom signal layer' End
Command  Name = 'EasyEDASwitchNextSignalLayer' LongSummary = 'Switch the active PCB editor to the next displayed signal layer' End
Command  Name = 'EasyEDASwitchPreviousSignalLayer' LongSummary = 'Switch the active PCB editor to the previous displayed signal layer' End
Command  Name = 'EasyEDASwitchToSelectedPrimitiveLayer' LongSummary = 'Switch the active PCB editor to the selected primitive layer' End
Command  Name = 'EasyEDADuplicateLayout' LongSummary = 'Duplicate selected PCB layout with local AI mapping' End
Command  Name = 'EasyEDAExportShapeAll' LongSummary = 'Export Mechanical 2 shapes for all PCB components or footprints as SVG' End
Command  Name = 'EasyEDAExportShapeSelected' LongSummary = 'Export Mechanical 2 shape for selected PCB component or footprint as SVG' End
Command  Name = 'EasyEDAExportShapeAllWithPads' LongSummary = 'Export Mechanical 2 shapes and pads for all PCB components or library footprints as SVG' End
Command  Name = 'EasyEDAExportShapeSelectedWithPads' LongSummary = 'Export Mechanical 2 shape and pads for the selected PCB library footprint as SVG' End
Command  Name = 'EasyEDAExportShapeSelectedLibraries' LongSummary = 'Export all Mechanical 2 footprint shapes from selected PCB libraries as SVG' End
Command  Name = 'EasyEDAOpenSymbolLibrary' LongSummary = 'Open the selected schematic component symbol library' End
Command  Name = 'EasyEDAOpenFootprintLibrary' LongSummary = 'Open the selected PCB component footprint library' End
Command  Name = 'EasyEDAImportJlcCamArchive' LongSummary = 'Import JLC production archive rail features into the active PCB' End
Command  Name = 'EasyEDAImportJlcCamFolder' LongSummary = 'Import extracted JLC production folder rail features into the active PCB' End
Command  Name = 'EasyEDAAddEdgeRails' LongSummary = 'Generate keepout edge rails, tooling holes and fiducials around the active PCB' End
