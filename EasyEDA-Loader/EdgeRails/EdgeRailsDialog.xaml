<Window x:Class="EasyEDA_Loader.EdgeRailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Edge Rails" Height="760" Width="1200" MinHeight="600" MinWidth="900"
        ShowInTaskbar="False" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" Background="#3E3E3E" Foreground="#F4F4F4" Loaded="Window_Loaded">
    <Window.Resources>
        <Style TargetType="{x:Type TextBlock}"><Setter Property="Foreground" Value="#F4F4F4"/></Style>
        <Style TargetType="{x:Type GroupBox}"><Setter Property="Foreground" Value="#F4F4F4"/><Setter Property="BorderBrush" Value="#666666"/><Setter Property="Background" Value="#464646"/></Style>
        <Style TargetType="{x:Type Button}"><Setter Property="Foreground" Value="#F4F4F4"/><Setter Property="Background" Value="#4A4A4A"/><Setter Property="BorderBrush" Value="#171717"/><Setter Property="Padding" Value="12,4"/></Style>
        <Style TargetType="{x:Type TextBox}"><Setter Property="Foreground" Value="#F4F4F4"/><Setter Property="Background" Value="#363636"/><Setter Property="BorderBrush" Value="#646464"/><Setter Property="CaretBrush" Value="#F4F4F4"/><Setter Property="Padding" Value="4,2"/></Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="sourceText" FontWeight="SemiBold" TextWrapping="Wrap"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="#666666" Background="#303030" BorderThickness="1" Padding="4">
                <Border x:Name="previewViewport" Background="#303030" ClipToBounds="True">
                    <Canvas x:Name="previewCanvas" Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                </Border>
            </Border>
            <StackPanel Grid.Column="2">
                <GroupBox Header="Rails (mm)" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Horizontal (top &amp; bottom)" Margin="0,0,0,2"/>
                        <TextBox x:Name="horizontalRailTextBox" TextChanged="Input_Changed"/>
                        <TextBlock Text="0 disables top/bottom rails" Margin="0,2,0,8" FontSize="11" Foreground="#A0A0A0"/>
                        <TextBlock Text="Vertical (left &amp; right)" Margin="0,0,0,2"/>
                        <TextBox x:Name="verticalRailTextBox" TextChanged="Input_Changed"/>
                        <TextBlock Text="0 disables left/right rails" Margin="0,2,0,0" FontSize="11" Foreground="#A0A0A0"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Features (mm)" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Tooling hole Ø" Margin="0,0,0,2"/>
                        <TextBox x:Name="holeSizeTextBox" TextChanged="Input_Changed"/>
                        <TextBlock Text="Fiducial Ø" Margin="0,8,0,2"/>
                        <TextBox x:Name="fiducialSizeTextBox" TextChanged="Input_Changed"/>
                    </StackPanel>
                </GroupBox>
                <TextBlock x:Name="hintText" TextWrapping="Wrap" Foreground="#CFCFCF"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="addButton" Grid.Column="1" Content="Add rails" Margin="0,0,8,0" Padding="20,4" IsEnabled="False" Click="Add_Click"/>
            <Button Grid.Column="2" Content="Cancel" Padding="20,4" Click="Cancel_Click"/>
        </Grid>
    </Grid>
</Window>
