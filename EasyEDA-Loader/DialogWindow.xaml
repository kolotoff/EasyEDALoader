<Window x:Class="EasyEDA_Loader.DialogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="EasyEDA Component Loader"
    Height="820"
    Width="1600"
    MinHeight="680"
    MinWidth="1360"
    WindowStartupLocation="CenterScreen"
    ShowInTaskbar="False"
    ResizeMode="CanResize"
    Loaded="Window_Loaded">
    <Window.Resources>
        <SolidColorBrush x:Key="DialogBackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="DialogTextBrush" Color="#111111"/>
        <SolidColorBrush x:Key="DialogBorderBrush" Color="#9A9A9A"/>
        <SolidColorBrush x:Key="DialogControlBrush" Color="#F4F4F4"/>
        <SolidColorBrush x:Key="DialogControlHoverBrush" Color="#E8E8E8"/>
        <SolidColorBrush x:Key="DialogControlPressedBrush" Color="#DCDCDC"/>
        <SolidColorBrush x:Key="DialogDisabledBrush" Color="#DADADA"/>
        <SolidColorBrush x:Key="DialogDisabledTextBrush" Color="#777777"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource DialogTextBrush}"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource DialogTextBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource DialogTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DialogBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#4A90E2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="Background" Value="{StaticResource DialogControlBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource DialogTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DialogBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource DialogControlHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource DialogControlPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource DialogDisabledBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource DialogDisabledTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource DialogTextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Box"
                                    Width="13"
                                    Height="13"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Background="#FFFFFF"
                                    BorderBrush="{StaticResource DialogBorderBrush}"
                                    BorderThickness="1">
                                <Path x:Name="CheckMark"
                                      Data="M 2 6 L 5 9 L 11 2"
                                      Stroke="{StaticResource DialogTextBrush}"
                                      StrokeThickness="2"
                                      StrokeEndLineCap="Square"
                                      StrokeStartLineCap="Square"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource DialogTextBrush}"/>
            <Setter Property="RowBackground" Value="#FFFFFF"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFAFA"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E4E4E4"/>
            <Setter Property="BorderBrush" Value="#AFC3DA"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F3F6FA"/>
            <Setter Property="Foreground" Value="{StaticResource DialogTextBrush}"/>
            <Setter Property="BorderBrush" Value="#D8DDE5"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="5,2"/>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Foreground" Value="#2F74C0"/>
            <Setter Property="Background" Value="#E4E4E4"/>
            <Setter Property="BorderBrush" Value="#C8C8C8"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="mainGrid" Background="{StaticResource DialogBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="42.5*"/>
            <ColumnDefinition Width="20*"/>
            <ColumnDefinition Width="37.5*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Padding="12,15,12,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                           Text="Enter part number(s) to search or import (e.g. C2040, C25804):"
                           Margin="0,0,0,8"/>

                <TextBox x:Name="searchTextBox"
                         Grid.Row="1"
                         Grid.Column="0"
                         Margin="0,0,8,0"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top"
                         Height="52"
                         KeyDown="SearchTextBox_KeyDown"/>

                <Button x:Name="searchButton"
                        Grid.Row="1"
                        Grid.Column="1"
                        Content="Search"
                        Width="75"
                        Height="52"
                        Click="SearchButton_Click"/>

                <StackPanel x:Name="searchProgressPanel"
                            Grid.Row="2"
                            Grid.ColumnSpan="2"
                            Margin="0,8,0,0"
                            Visibility="Collapsed">
                    <ProgressBar x:Name="searchProgressBar"
                                 IsIndeterminate="True"/>
                    <TextBlock x:Name="searchProgressText"
                               Margin="0,4,0,0"
                               FontSize="11"
                               Foreground="#4B4B4B"/>
                </StackPanel>
            </Grid>
        </Border>

        <DataGrid x:Name="resultsGrid"
                  Grid.Row="1"
                  Grid.Column="0"
                  Margin="12,0,12,10"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  HeadersVisibility="Column"
                  IsReadOnly="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  SelectionChanged="ResultsGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="40" MinWidth="40">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding AddToLibrary, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="FP" Width="40" MinWidth="40">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding HasFootprint, Mode=OneWay}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      IsEnabled="False"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="3D" Width="40" MinWidth="40">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Has3d, Mode=OneWay}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      IsEnabled="False"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Name"
                                    Binding="{Binding Name}"
                                    Width="150"
                                    MinWidth="100"
                                    IsReadOnly="True"/>

                <DataGridTextColumn Header="Description"
                                    Binding="{Binding Description}"
                                    Width="*"
                                    MinWidth="200"
                                    IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border x:Name="operationProgressPanel"
                Grid.Row="1"
                Grid.Column="0"
                Margin="12,0,12,10"
                Padding="10"
                Background="#FFFFFF"
                BorderBrush="#AFC3DA"
                BorderThickness="1"
                Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="operationProgressText"
                           Grid.Row="0"
                           Text="Importing..."
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>
                <ProgressBar x:Name="operationProgressBar"
                             Grid.Row="1"
                             IsIndeterminate="True"
                             Margin="0,0,0,8"/>
                <TextBox x:Name="operationLogTextBox"
                         Grid.Row="2"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="11"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="12,0,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="STEP cleanup"
                           Width="92"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>
                <CheckBox x:Name="removeWatermarkCheckBox"
                          Content="Remove Watermark"
                          IsChecked="True"
                          Checked="StepCleanOptionsChanged"
                          Unchecked="StepCleanOptionsChanged"
                          VerticalAlignment="Center"/>
                <CheckBox x:Name="cleanTextCheckBox"
                          Content="Clean text"
                          Margin="16,0,0,0"
                          IsChecked="False"
                          Checked="StepCleanOptionsChanged"
                          Unchecked="StepCleanOptionsChanged"
                          VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                <TextBlock Text="Footprint"
                           Width="92"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>
                <CheckBox x:Name="importLcscMechanicalLayersCheckBox"
                          Content="Import LCSC Mechanical Layers"
                          IsChecked="False"
                          Checked="ImportOptionsChanged"
                          Unchecked="ImportOptionsChanged"
                          VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="saveModelButton"
                        Content="Export STEP"
                        Width="100"
                        Height="24"
                        Margin="0,0,8,0"
                        IsEnabled="False"
                        Click="SaveModelButton_Click"/>
                <Button x:Name="regenerateCleanStepButton"
                        Content="Regenerate Clean STEP"
                        Width="145"
                        Height="24"
                        Margin="0,0,8,0"
                        IsEnabled="False"
                        Click="RegenerateCleanStepButton_Click"/>
                <Button x:Name="removeCacheButton"
                        Content="Remove cache"
                        Width="105"
                        Height="24"
                        Margin="0,0,100,0"
                        IsEnabled="False"
                        Click="RemoveCacheButton_Click"/>
                <Button x:Name="addToLibraryButton"
                        Content="Import to temp"
                        Width="110"
                        Height="24"
                        Margin="0,0,8,0"
                        IsEnabled="False"
                        Click="AddToLibraryButton_Click"/>
                <Button x:Name="addFootprintButton"
                        Content="Add footprint"
                        Width="110"
                        Height="24"
                        Margin="0,0,8,0"
                        IsEnabled="False"
                        Click="AddFootprintButton_Click"/>
                <Button x:Name="addSymbolButton"
                        Content="Add symbol"
                        Width="90"
                        Height="24"
                        Margin="0,0,100,0"
                        IsEnabled="False"
                        Click="AddSymbolButton_Click"/>
                <Button x:Name="cancelButton"
                        Content="Cancel"
                        Width="75"
                        Height="24"
                        IsCancel="True"
                        Click="CancelButton_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                BorderThickness="1,0,0,0"
                Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Preview"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10"/>

                <StackPanel x:Name="previewProgressPanel"
                            Grid.Row="1"
                            Margin="0,0,0,10"
                            Visibility="Collapsed">
                    <ProgressBar x:Name="previewProgressBar"
                                 IsIndeterminate="True"/>
                    <TextBlock x:Name="previewProgressText"
                               Margin="0,4,0,0"
                               FontSize="11"
                               Foreground="#4B4B4B"/>
                </StackPanel>

                <Viewbox x:Name="thumbnailViewbox" Grid.Row="2"
                         MinHeight="50"
                         HorizontalAlignment="Center"
                         Stretch="Uniform"
                         Margin="0,0,0,10">
                    <Image x:Name="thumbnailImage" Height="50" Width="50"/>
                </Viewbox>

                <ScrollViewer x:Name="symbolCanvasView"
                              Grid.Row="3"
                              VerticalAlignment="Stretch"
                              HorizontalAlignment="Stretch"
                              Margin="0,0,0,10"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Hidden"
                              Background="Black">
                    <Canvas x:Name="symbolCanvas" Height="100" Width="100"
                            HorizontalAlignment="Left" VerticalAlignment="Top"/>
                </ScrollViewer>

                <ScrollViewer x:Name="footprintCanvasView"
                              Grid.Row="4"
                              VerticalAlignment="Stretch"
                              HorizontalAlignment="Stretch"
                              Margin="0,0,0,10"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Hidden"
                              Background="Black">
                    <Canvas x:Name="footprintCanvas" Height="100" Width="100"
                            HorizontalAlignment="Left" VerticalAlignment="Top"/>
                </ScrollViewer>

                <Border x:Name="modelProjectionViewport"
                        Grid.Row="5"
                        Background="#FAFAFA">
                    <Image x:Name="modelProjectionImage"
                           Stretch="Uniform"
                           Width="{Binding ActualWidth, ElementName=modelProjectionViewport}"
                           Height="{Binding ActualHeight, ElementName=modelProjectionViewport}"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Top"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           ClipToBounds="True"/>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="2"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                BorderThickness="1,0,0,0"
                Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="f3dPreviewTitleTextBlock"
                           Grid.Row="0"
                           Text="Original STEP"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10"/>

                <Border x:Name="f3dModelViewport"
                        Grid.Row="1"
                        Background="White">
                    <Image x:Name="f3dModelImage"
                           Stretch="Uniform"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           SnapsToDevicePixels="True"
                           MouseDown="F3DPreviewImage_MouseDown"
                           MouseMove="F3DPreviewImage_MouseMove"
                           MouseUp="F3DPreviewImage_MouseUp"
                           MouseWheel="F3DPreviewImage_MouseWheel"
                           SizeChanged="F3DPreviewImage_SizeChanged"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
